[Unit]
Description=OpenClaw sandbox gateway (sbx autostart)
Documentation=https://docs.openclaw.ai/
After=network-online.target docker.service
Wants=network-online.target
# Bound restart storms: a persistent failure (e.g. logged out — `sbx login`
# missing) must not re-hit the Secret Service / keyring every few seconds.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/Documents/Projects/openclaw-sandbox
# Idempotent: ensures sandboxd is up; sbx exec below auto-starts a
# stopped sandbox (no agent re-attach on gateway restarts).
ExecStartPre=/usr/bin/sbx daemon start --detach
# sbx exec auto-starts a stopped sandbox; gateway runs foreground so
# systemd can supervise it. Port/token come from sandbox config (18789).
# Requires `sbx login` — without it exec exits 1 ("not signed in to Docker").
ExecStart=/usr/bin/sbx exec openclaw-sbx -- openclaw gateway run
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
